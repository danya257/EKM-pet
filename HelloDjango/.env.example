# Скопируйте файл как .env и заполните значения.
# .env уже в .gitignore — не коммитьте.

# Сгенерировать ключ:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 'True' только в локальной разработке. На проде — 'False'.
DJANGO_DEBUG=False

